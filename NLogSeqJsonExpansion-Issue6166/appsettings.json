{
  "NLog": {
    "throwConfigExceptions": true,
    "extensions": [
      { "assembly": "NLog.Targets.Seq" }
    ],
    "targets": {
      "console": {
        "type": "Console",
        "layout": "${date:format=HH\\:mm\\:ss} ${pad:padding=5:inner=${level:uppercase=true}} ${message}"
      },
      "seq": {
        "type": "BufferingWrapper",
        "bufferSize": 200,
        "flushTimeout": 2000,
        "slidingTimeout": false,
        "target": {
          "type": "Seq",
          "serverUrl": "http://localhost:5341",
          "apiKey": "",
          "properties": [
            {
              "name": "MachineName",
              "value": "${MachineName}"
            }
          ]
        }
      }
    },
    "rules": [
      {
        "ruleName": "console",
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "console"
      },
      {
        "ruleName": "seq",
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "seq"
      }
    ]
  }
}